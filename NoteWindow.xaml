<Window x:Class="ClassicStickyNotes.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sticky Note" 
        Height="400" Width="360"
        MinHeight="200" MinWidth="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Sleek Thin Scrollbar Style (Applied globally) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#40808080" CornerRadius="2.5" Width="5" Margin="0,2,0,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#80808080"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#B0808080"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Header Button Style -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Border}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Header Button Style (Close) -->
        <Style x:Key="DangerHeaderBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53935"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dialog Primary Button -->
        <Style x:Key="ModernPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dialog Ghost Button -->
        <Style x:Key="ModernGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <!-- Outer Card Frame with Smooth Drop Shadow -->
        <Border x:Name="MainCard" 
                CornerRadius="7" 
                BorderThickness="1" 
                ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.28" ShadowDepth="3" Direction="270" Color="#101010"/>
            </Border.Effect>

            <Grid x:Name="CardContentGrid" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>  <!-- Header -->
                    <RowDefinition Height="*"/>   <!-- Body (True Obsidian Live Preview Canvas) -->
                    <RowDefinition Height="22"/>  <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. Clean Header Bar (No Mode Toggles, Just Pure Sticky Note Actions) -->
                <Border Grid.Row="0" x:Name="HeaderBar" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                    <Grid Margin="6,0,6,0">
                        <!-- Left: New Note -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderBtn}" Width="26" Height="26" Click="NewNote_Click" ToolTip="New Note (Ctrl+N)">
                                <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Right: Actions & Tools -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Always on Top / Pin -->
                            <Button x:Name="BtnPin" Style="{StaticResource HeaderBtn}" Width="26" Height="26" Click="Pin_Click" ToolTip="Always on Top (Ctrl+P)">
                                <TextBlock x:Name="TxtPinIcon" Text="📌" FontSize="11" Opacity="0.35"/>
                            </Button>

                            <!-- Color Palette -->
                            <Button Style="{StaticResource HeaderBtn}" Width="26" Height="26" Click="Palette_Click" ToolTip="Note Color">
                                <TextBlock Text="🎨" FontSize="12"/>
                            </Button>

                            <!-- Font Selector -->
                            <Button Style="{StaticResource HeaderBtn}" Width="26" Height="26" Click="Font_Click" ToolTip="Font &amp; Size">
                                <TextBlock Text="🔤" FontSize="12"/>
                            </Button>

                            <!-- More Menu -->
                            <Button Style="{StaticResource HeaderBtn}" Width="24" Height="26" Click="More_Click" ToolTip="More Options">
                                <TextBlock Text="⋮" FontSize="13" FontWeight="Bold"/>
                            </Button>

                            <!-- Close Button -->
                            <Button Style="{StaticResource DangerHeaderBtn}" Width="26" Height="26" Click="Close_Click" ToolTip="Close Note">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Obsidian Live Preview Canvas -->
                <ScrollViewer Grid.Row="1" x:Name="EditorScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0"
                              Background="Transparent">
                    <StackPanel x:Name="LinesStackPanel" 
                                Background="Transparent" 
                                Margin="12,10,12,10"
                                ClipToBounds="False"/>
                </ScrollViewer>

                <!-- 3. Footer Bar -->
                <Border Grid.Row="2" x:Name="FooterBar" BorderThickness="0,1,0,0">
                    <Grid Margin="10,0,4,0">
                        <!-- Stats & Info -->
                        <TextBlock x:Name="TxtFooterStats" 
                                   Text="Saved" 
                                   FontSize="10" 
                                   Opacity="0.6" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left"/>

                        <!-- Resize Grip (Bottom-Right) -->
                        <Border Width="14" Height="14" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Cursor="SizeNWSE" 
                                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                                Background="Transparent"
                                ToolTip="Drag to resize">
                            <TextBlock Text="⋰" FontSize="13" FontWeight="Bold" Opacity="0.4" 
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. Modern In-App Modal Dialog Overlay -->
                <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="DialogOverlay" 
                      Visibility="Collapsed" 
                      Background="#66000000"
                      ClipToBounds="True">
                    <Border x:Name="DialogCard"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Background="#FFFFFF" 
                            CornerRadius="9" 
                            Padding="20,18" 
                            MaxWidth="290" 
                            BorderThickness="1" 
                            BorderBrush="#E2E8F0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Opacity="0.25" ShadowDepth="4" Direction="270" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Dialog Header with Icon -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtDialogIcon" Text="⚠️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDialogTitle" Text="Confirm" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Dialog Message -->
                            <TextBlock x:Name="TxtDialogMessage" 
                                       Text="Are you sure you want to proceed?" 
                                       FontSize="12" 
                                       Foreground="#475569" 
                                       TextWrapping="Wrap" 
                                       LineHeight="17" 
                                       Margin="0,0,0,16"/>

                            <!-- Dialog Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnDialogCancel" 
                                        Content="Cancel" 
                                        Style="{StaticResource ModernGhostBtn}" 
                                        Click="DialogCancel_Click" 
                                        Margin="0,0,8,0"/>
                                <Button x:Name="BtnDialogConfirm" 
                                        Content="Confirm" 
                                        Style="{StaticResource ModernPrimaryBtn}" 
                                        Click="DialogConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Invisible Resize Handles (8 borders/corners) -->
        <Border Height="6" VerticalAlignment="Top" Margin="6,0,6,0" Cursor="SizeNS" Background="Transparent" MouseLeftButtonDown="Resize_Top"/>
        <Border Height="6" VerticalAlignment="Bottom" Margin="6,0,6,0" Cursor="SizeNS" Background="Transparent" MouseLeftButtonDown="Resize_Bottom"/>
        <Border Width="6" HorizontalAlignment="Left" Margin="0,6,0,6" Cursor="SizeWE" Background="Transparent" MouseLeftButtonDown="Resize_Left"/>
        <Border Width="6" HorizontalAlignment="Right" Margin="0,6,0,6" Cursor="SizeWE" Background="Transparent" MouseLeftButtonDown="Resize_Right"/>

        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Transparent" MouseLeftButtonDown="Resize_TopLeft"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Background="Transparent" MouseLeftButtonDown="Resize_TopRight"/>
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Transparent" MouseLeftButtonDown="Resize_BottomLeft"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" MouseLeftButtonDown="Resize_BottomRight"/>
    </Grid>
</Window>
